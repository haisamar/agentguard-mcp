# =========================================================
# AgentGuard MCP Server
# Example environment configuration
# =========================================================


# ---------------------------------------------------------
# Auth0
# ---------------------------------------------------------

# Auth0 tenant domain
# Example:
# dev-example.us.auth0.com
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Auth0 API audience used by the protected MCP server.
# This must exactly match the API Identifier configured in Auth0.
AUTH0_AUDIENCE=http://localhost:3001/

# Public/base URL used in MCP OAuth protected-resource metadata.
MCP_SERVER_URL=http://localhost:3001/

PORT=3001
DEBUG=false


# ---------------------------------------------------------
# Agent Machine Identities
# ---------------------------------------------------------

# Sales Agent Runtime
SALES_AGENT_CLIENT_ID=
SALES_AGENT_CLIENT_SECRET=

# Finance Agent Runtime
FINANCE_AGENT_CLIENT_ID=
FINANCE_AGENT_CLIENT_SECRET=

# Administrative machine runtime
ADMIN_AGENT_CLIENT_ID=
ADMIN_AGENT_CLIENT_SECRET=


# ---------------------------------------------------------
# Supabase
# ---------------------------------------------------------

# Example:
# https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Server-side secret key.
# Never expose this value to browser/client code.
SUPABASE_SECRET_KEY=


# ---------------------------------------------------------
# Optional CORS
# ---------------------------------------------------------

CORS_ORIGINS=*